{
  "name": "dream-drive-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Mercedes-Benz GLC Coupé를 참고한 드림카로 서울 강남·송파 도심을 달리는 웹 3D 드라이빙 시뮬레이터",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "osm:fetch": "node tools/fetch-osm.mjs",
    "osm:build": "node tools/osm-to-map.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jngbnss/dream-drive-simulator.git"
  },
  "license": "MIT",
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.14.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true
  }
}
